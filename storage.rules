rules_version = '2';

// Deny by default. Media binaries live at orgs/{orgId}/media/{mediaId}/{file}.
// Browsers may upload ONLY the "original" of a media item that a Cloud Function reserved
// (status "uploading", same user, declared type, at most the declared size). Variants and
// thumbnails are written by the processing function. Devices get signed URLs (phase 3/4).
service firebase.storage {
  match /b/{bucket}/o {
    function memberPath(orgId) {
      return /databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid);
    }

    // One cross-service lookup per request (a missing member doc makes get() fail → deny).
    // Each lookup is a billed Firestore read, so avoid exists() + get() pairs.
    function isActiveMember(orgId) {
      return request.auth != null
        && request.auth.token.get('type', null) != 'device'
        && firestore.get(memberPath(orgId)).data.status == 'active';
    }

    match /orgs/{orgId}/media/{mediaId}/{file} {
      allow read: if isActiveMember(orgId);

      allow create: if file == 'original'
        && isActiveMember(orgId)
        && request.resource.size > 0
        && reservationAllows(orgId, mediaId);

      allow update, delete: if false;
    }

    // Screenshots requested with the "screenshot" remote command (written by Functions).
    match /orgs/{orgId}/screenshots/{allPaths=**} {
      allow read: if isActiveMember(orgId);
      allow write: if false;
    }

    // Player release APKs: uploaded by the staff member who reserved the slot (createPlayerReleaseUpload),
    // read by players through download-token URLs only.
    match /playerReleases/{releaseId}/player.apk {
      allow create: if request.auth != null
        && request.auth.token.get('platformRole', null) in ['superadmin', 'ops']
        && request.resource.size > 0
        && request.resource.contentType == 'application/vnd.android.package-archive'
        && releaseAllows(releaseId);
      allow read, update, delete: if false;
    }

    function releaseAllows(releaseId) {
      let release = firestore.get(/databases/(default)/documents/playerReleases/$(releaseId)).data;
      return release.status == 'uploading'
        && release.createdBy == request.auth.uid
        && request.resource.size <= release.bytes;
    }

    function reservationAllows(orgId, mediaId) {
      let media = firestore.get(/databases/(default)/documents/orgs/$(orgId)/media/$(mediaId)).data;
      return media.status == 'uploading'
        && media.createdBy == request.auth.uid
        && request.resource.size <= media.bytes
        && request.resource.contentType == media.mimeType;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
