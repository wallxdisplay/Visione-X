rules_version = '2';

// WallX Play Firestore rules.
// Principle: deny by default. In phase 1 every write goes through Cloud Functions (Admin SDK
// bypasses rules), which check permissions and write an audit entry in the same transaction.
// Clients get narrowly scoped READ access only.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isDevice() {
      // .get(): ordinary users have no `type` claim, and a missing field is an error in rules.
      return signedIn() && request.auth.token.get('type', null) == 'device';
    }

    // Staff must sign in with two-step verification (TOTP): without a second factor in this
    // sign-in, a staff account is treated as an ordinary user here, as in Cloud Functions.
    function hasSecondFactor() {
      return request.auth.token.get('firebase', {}).get('sign_in_second_factor', null) != null;
    }

    function platformRole() {
      return signedIn() && !isDevice() && hasSecondFactor() ? request.auth.token.get('platformRole', null) : null;
    }

    function isPlatformStaff() {
      return platformRole() in ['superadmin', 'support', 'billing', 'ops', 'auditor'];
    }

    // Platform roles holding billing.view (see PLATFORM_ROLE_PERMISSIONS).
    function isBillingStaff() {
      return platformRole() in ['superadmin', 'billing', 'auditor'];
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid);
    }

    function isActiveMember(orgId) {
      return signedIn() && !isDevice()
        && exists(memberPath(orgId))
        && activeRecord(get(memberPath(orgId)).data);
    }

    // WallX support staff hold a temporary member record that ends at support.expiresAt.
    function activeRecord(member) {
      return member.status == 'active'
        && (member.get('support', null) == null || member.support.expiresAt > request.time.toMillis());
    }

    // Platform roles holding device.view (see PLATFORM_ROLE_PERMISSIONS): screen health and commands.
    function isDeviceStaff() {
      return platformRole() in ['superadmin', 'support', 'ops', 'auditor'];
    }

    // Member docs carry a denormalized `permissions` list written by Functions.
    function hasPerm(orgId, permission) {
      return isActiveMember(orgId) && permission in get(memberPath(orgId)).data.permissions;
    }

    // Site scope (member.siteScope; empty = all sites); mirrors inSiteScope in packages/shared.
    // A scoped member must list with where('siteId', 'in', scope) for queries to be allowed.
    function inSiteScope(orgId, siteId) {
      let scope = get(memberPath(orgId)).data.get('siteScope', []);
      return scope.size() == 0 || (siteId != null && siteId in scope);
    }

    function siteOf(orgId, collection, id) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/$(collection)/$(id)).data.get('siteId', null);
    }

    // ---------- platform-level ----------
    match /platformUsers/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || platformRole() == 'superadmin';
      allow write: if false;
    }

    match /plans/{planId} {
      // Public pricing page and the billing UI need active plans.
      allow read: if resource.data.active == true || isPlatformStaff();
      allow write: if false;
    }

    // White label: custom web address → brand, read before sign-in (names, colours, logo only).
    match /brandDomains/{hostname} {
      allow get: if true;
      allow list, write: if false;
    }

    // Reseller accounts: WallX staff and the reseller's own team (partner portal); written only by Functions.
    function isAccountMember(accountId) {
      return signedIn() && !isDevice() && exists(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid));
    }

    match /accounts/{accountId} {
      allow read: if isPlatformStaff() || isAccountMember(accountId);
      allow write: if false;

      match /{collection}/{docId} {
        allow read: if collection in ['members', 'invites', 'payments'] && (isPlatformStaff() || isAccountMember(accountId));
        allow write: if false;
      }
    }

    // Player app releases (device.view roles); written only by Cloud Functions.
    match /playerReleases/{releaseId} {
      allow read: if platformRole() in ['superadmin', 'support', 'ops', 'auditor'];
      allow write: if false;
    }

    // Support contacts, notice banner, signups switch (written only by Cloud Functions).
    match /platform/settings {
      allow read: if signedIn();
      allow write: if false;
    }

    // App catalog (App store): prices are public to signed-in users; costs only to billing staff.
    match /apps/{appId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /appCosts/{appId} {
      allow read: if isBillingStaff();
      allow write: if false;
    }

    // Cost tracking: unit costs (staff).
    match /platform/costRates {
      allow read: if isBillingStaff();
      allow write: if false;
    }

    match /platform/featureCatalog {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid && !isDevice();
      allow write: if false;
    }

    match /signupRequests/{requestId} {
      allow read: if (signedIn() && resource.data.requestedBy == request.auth.uid) || isPlatformStaff();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if platformRole() in ['superadmin', 'auditor'];
      allow create, update, delete: if false; // append-only via Functions
    }

    // auditHeads, inviteTokens and anything else fall through to the deny-all rule below.

    // ---------- organizations ----------
    match /orgs/{orgId} {
      allow read: if isActiveMember(orgId) || isPlatformStaff();
      allow write: if false;

      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || hasPerm(orgId, 'member.view') || isPlatformStaff();
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read: if hasPerm(orgId, 'member.manage') || isPlatformStaff();
        allow write: if false;
      }

      // Custom roles: names and permission lists, shown wherever roles are (Team page).
      match /roles/{roleId} {
        allow read: if isActiveMember(orgId) || isPlatformStaff();
        allow write: if false;
      }

      match /sites/{siteId} {
        allow read: if isActiveMember(orgId) || isPlatformStaff();
        allow write: if false;
      }

      match /entitlements/{docId} {
        allow read: if isActiveMember(orgId) || isPlatformStaff();
        allow write: if false;
      }

      match /usage/{docId} {
        allow read: if isActiveMember(orgId) || isPlatformStaff();
        allow write: if false;
      }

      // Content: readable by active members only, written only by Functions. WallX staff see it
      // only through a support access grant (a temporary member record).
      match /{collection}/{docId} {
        allow read: if collection in ['media', 'folders', 'layouts', 'playlists', 'screenGroups', 'syncGroups', 'schedules',
                                      'emergencies', 'notifications', 'approvals', 'dataSources']
          && isActiveMember(orgId);
        allow write: if false;
      }

      // Screens, limited to the member's sites; command history follows its screen.
      match /screens/{screenId} {
        allow read: if (isActiveMember(orgId) && inSiteScope(orgId, resource.data.get('siteId', null))) || isDeviceStaff();
        allow write: if false;

        match /commands/{commandId} {
          allow read: if (isActiveMember(orgId) && inSiteScope(orgId, siteOf(orgId, 'screens', screenId))) || isDeviceStaff();
          allow write: if false;
        }

        // Diagnostics history (errors, offline/online, updates), written by Functions.
        match /events/{eventId} {
          allow read: if (hasPerm(orgId, 'screen.view') && inSiteScope(orgId, siteOf(orgId, 'screens', screenId))) || isDeviceStaff();
          allow write: if false;
        }
      }

      // Sensors (phase 5). API keys live in the server-only sensorKeys collection, never here.
      match /sensorDevices/{sensorId} {
        allow read: if hasPerm(orgId, 'sensor.view') && inSiteScope(orgId, resource.data.get('siteId', null));
        allow write: if false;

        match /channels/{channelId} {
          allow read: if hasPerm(orgId, 'sensor.view') && inSiteScope(orgId, siteOf(orgId, 'sensorDevices', sensorId));
          allow write: if false;

          match /readings/{bucketId} {
            allow read: if hasPerm(orgId, 'sensor.view') && inSiteScope(orgId, siteOf(orgId, 'sensorDevices', sensorId));
            allow write: if false;
          }
        }
      }

      // MQTT brokers (never the password: mqttBrokerSecrets is server-only).
      match /mqttBrokers/{brokerId} {
        allow read: if hasPerm(orgId, 'sensor.view') && inSiteScope(orgId, resource.data.get('siteId', null));
        allow write: if false;
      }

      // Public API keys (never the key itself) and webhooks (never the signing secret).
      match /apiKeys/{keyId} {
        allow read: if hasPerm(orgId, 'apikey.manage');
        allow write: if false;
      }

      match /webhooks/{webhookId} {
        allow read: if hasPerm(orgId, 'apikey.manage');
        allow write: if false;

        match /deliveries/{deliveryId} {
          allow read: if hasPerm(orgId, 'apikey.manage');
          allow write: if false;
        }
      }

      match /alerts/{alertId} {
        allow read: if hasPerm(orgId, 'sensor.view') && inSiteScope(orgId, resource.data.get('siteId', null));
        allow write: if false;
      }

      // Support access grants: visible to the whole organization and to support staff.
      match /supportGrants/{grantId} {
        allow read: if isActiveMember(orgId) || platformRole() in ['superadmin', 'support'];
        allow write: if false;
      }

      match /billing/{docId} {
        allow read: if hasPerm(orgId, 'billing.view') || isBillingStaff();
        allow write: if false;
      }

      // Manual payments and customer billing requests (phase 6).
      match /payments/{paymentId} {
        allow read: if hasPerm(orgId, 'billing.view') || isBillingStaff();
        allow write: if false;
      }

      // Online payment orders (Razorpay), written by Functions.
      match /paymentOrders/{orderId} {
        allow read: if hasPerm(orgId, 'billing.view') || isBillingStaff();
        allow write: if false;
      }

      match /billingRequests/{requestId} {
        allow read: if hasPerm(orgId, 'billing.view') || isBillingStaff();
        allow write: if false;
      }

      // Everything else under an org stays closed until its phase defines it.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ---------- platform staff with device.view: screens across organizations ----------
    match /{path=**}/screens/{screenId} {
      allow read: if isDeviceStaff();
    }

    // Support staff: all grants across organizations (Super Admin → Support access).
    match /{path=**}/supportGrants/{grantId} {
      allow read: if platformRole() in ['superadmin', 'support'];
    }

    // ---------- billing staff: lists across organizations ----------
    match /{path=**}/billing/{docId} {
      allow read: if isBillingStaff();
    }

    match /{path=**}/billingRequests/{requestId} {
      allow read: if isBillingStaff();
    }

    // ---------- fallback ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
