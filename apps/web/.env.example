# Copy to .env.local. These are public web-app config values (not secrets).
# Get them from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-wallx-play
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# true = use local emulators (default for development)
VITE_USE_EMULATORS=true

# App Check (reCAPTCHA Enterprise site key, public). Empty = App Check off. Production only.
VITE_APPCHECK_SITE_KEY=

# Never put Razorpay secret keys or any server secret in VITE_* variables.
