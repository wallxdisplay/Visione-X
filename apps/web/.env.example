# Copy to .env.local. These are public web-app config values (not secrets).
# Get them from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-visione-x
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# true = use local emulators (default for development)
VITE_USE_EMULATORS=true

# Never put Razorpay secret keys or any server secret in VITE_* variables.
